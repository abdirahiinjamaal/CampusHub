# FRONTEND_ORIGIN=https://your-cloudfront-domain.example.com

# Production only: the EC2 IAM role supplies AWS credentials.
AWS_REGION=us-east-1
DATABASE_SECRET_NAME=campushub/database
JWT_SECRET_NAME=campushub/jwt
