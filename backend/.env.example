PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=university

JWT_SECRET=change-this-in-production
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

